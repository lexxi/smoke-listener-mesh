#pragma once
#include <stdint.h>

// COPY this file to mesh_secrets.h alongside the .ino.
// Never commit your REAL key to a public repository.
// Replace EVERY key byte with cryptographically random values.
// Run in PowerShell to generate a key:
//   $b = New-Object byte[] 32
//   [System.Security.Cryptography.RandomNumberGenerator]::Fill($b)
//   ($b | ForEach-Object { '0x{0:X2}' -f $_ }) -join ', '

static constexpr uint32_t MESH_NETWORK_ID = 0x7A5C90E1; // non-secret network label; customize
static constexpr uint8_t MESH_SECRET_KEY[32] = {
  0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
  0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
  0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
  0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00
};

// REQUIRED for v0.5.6: Set a private WPA2 AP password of 12 to 63 characters.
// Same firmware image (including this password) can be used on every node.
// Do NOT publish this password or use the placeholder below.
// Shorter than 12 chars or the unchanged placeholder triggers:
// [CONFIG] ERROR: set private AP password first
static constexpr char MESH_CONFIG_AP_PASSWORD[] = "CHANGE-TO-PRIVATE-LONG-PASSWORD";
